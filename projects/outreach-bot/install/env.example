# Names only. Real values go in secrets\.env (created by the installer). One NAME=value per line.
# Required to write drafts:
OUTREACH_SHEET_ID=
# GOOGLE_SA is the whole service-account JSON. Easier: save the JSON file as secrets\google-sa.json (the runner reads it).
GOOGLE_SA=
# Lead sheets (all optional):
SHEET_ID_AU=
SHEET_ID_AU_ONLY=
SHEET_ID_US=
SHEET_ID_CA=
SHEET_ID_GB=
SHEET_ID_IE=
SHEET_ID_NZ=
SHEET_ID_AE=
SHEET_ID_SA=
SHEET_ID_QA=
SHEET_ID_YOUTUBE=
EXTRA_LEAD_SHEET_IDS=
# AI keys (all optional, free tiers):
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
